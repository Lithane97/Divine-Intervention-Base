# Refresh only editor state; catalogues and active-choice styling are live.
template DI_Faith_Editor_Anim {
    state = {
        name = _show
        on_start = "[GetVariableSystem.Clear('DI_fe_tab')]"
        using = Animation_FadeIn_Quick
        on_start = "[GetScriptedGui('DI_faith_editor_init_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        on_start = "[GetScriptedGui('DI_fe_sync_target_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        on_finish = "[PdxGuiWidget.StackTop]"
    }
    state = {
        name = _hide
        using = Animation_FadeOut_Quick
        on_start = "[GetScriptedGui('DI_fe_cancel_tenet_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
    state = {
        name = DI_fe_target_changed
        trigger_when = "[And(GetVariableSystem.Exists('DI_faith_editor_window_visible'), Not(GetScriptedGui('DI_fe_target_current_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]"
        on_start = "[GetScriptedGui('DI_fe_sync_target_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
    # Kept for the shared character-selection animation broadcast.
    state = {
        name = DI_fe_select_tenets
        on_start = "[GetScriptedGui('DI_fe_sync_target_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
}

types DI_Faith_Editor_Types {
    type DI_fe_tenet_card = button_standard_hover {
        size = { 185 96 }
        enabled = "[GetScriptedGui('DI_fe_select_tenet_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_rite', Rite.MakeScope).AddScope('tenet', TenetType.MakeScope).End)]"
        tooltip = "DI_fe_tenet_tooltip"
        using = tooltip_es
        block "DI_fe_tenet_action" {}
        background = {
            visible = "[Rite.HasTenet(TenetType.Self)]"
            using = Status_Good
            using = Color_Blue
            alpha = 0.15
        }
        highlight_icon = {
            block "DI_fe_tenet_icon_layout" {
                size = { 72 88 }
                parentanchor = left|vcenter
            }
            texture = "[Faith.GetTenetBackgroundSmallIcon(Rite.Self, TenetType.Self)]"
            alwaystransparent = yes
            proportional_icon = {
                size = { 95% 95% }
                parentanchor = top|hcenter
                texture = "[TenetType.GetIcon(Faith.Self)]"
                alpha = 0.85
                alwaystransparent = yes
            }
        }
        vbox = {
            block "DI_fe_tenet_label_layout" {
                position = { 40 4 }
                size = { 104 88 }
            }
            alwaystransparent = yes
            text_multi = {
                autoresize = no
                block "DI_fe_tenet_name_layout" {
                    size = { 104 64 }
                    max_width = 104
                    align = vcenter|nobaseline
                }
                text = "[TenetType.GetNameNoTooltip(Rite.Self)]"
                default_format = "#high"
                fontsize_min = 12
            }
            text_single = {
                block "DI_fe_tenet_status_layout" {
                    max_width = 104
                }
                visible = "[Rite.HasTenet(TenetType.Self)]"
                text = "DI_fe_current"
                default_format = "#low"
            }
        }
    }

    # Four 160px cards plus three 12px gaps occupy 676px, leaving room
    # in the 800px picker for window margins, content padding and scrollbar.
    type DI_fe_tenet_picker_card = DI_fe_tenet_card {
        size = { 160 140 }
        blockoverride "DI_fe_tenet_icon_layout" {
            size = { 88 108 }
            parentanchor = top|hcenter
            position = { 0 6 }
        }
        blockoverride "DI_fe_tenet_label_layout" {
            position = { 0 50 }
            size = { 144 80 }
        }
        blockoverride "DI_fe_tenet_name_layout" {
            size = { 144 56 }
            max_width = 144
            align = center|vcenter|nobaseline
        }
        blockoverride "DI_fe_tenet_status_layout" {
            size = { 144 24 }
            max_width = 144
            align = center
        }
    }

    type DI_fe_doctrine_category = vbox {
        layoutpolicy_horizontal = expanding
        visible = "[DoctrineCategoryType.IsVisible]"
        oncreate = "[BindFoldOutContext]"
        block "DI_fe_initial_fold" {
            oncreate = "[PdxGuiFoldOut.Fold]"
        }
        button_expandable_toggle_field = {
            blockoverride "text" {
                text = "[DoctrineCategoryType.GetName]"
                default_format = "#T"
            }
        }
        vbox = {
            layoutpolicy_horizontal = expanding
            visible = "[PdxGuiFoldOut.IsUnfolded]"
            ignoreinvisible = yes
            # A one-item gate builds only this category's generated groups.
            # TenetType is unused here; the category context remains inherited.
            datamodel = "[DataModelFirst(GetAllTenetTypes, Select_int32(And(PdxGuiFoldOut.IsUnfolded, DoctrineCategoryType.IsVisible), '(int32)1', '(int32)0'))]"
            item = {
                # A datamodel item accepts exactly one root widget. Keep all
                # generated sibling groups inside this shared layout container.
                vbox = {
                    layoutpolicy_horizontal = expanding
                    ignoreinvisible = yes
                    block "DI_fe_category_groups" {}
                }
            }
        }
    }

    type DI_fe_doctrine_group = vbox {
        layoutpolicy_horizontal = expanding
        visible = "[ObjectsEqual(DoctrineGroupType.GetCategory, DoctrineCategoryType.Self)]"
        margin = { 10 6 }
        spacing = 4
        hbox = {
            layoutpolicy_horizontal = expanding
            min_height = 30
            background = { using = Background_Area_Solid }
            text_single = {
                layoutpolicy_horizontal = expanding
                margin = { 8 3 }
                text = "[DoctrineGroupType.GetName(Faith.Self)]"
                default_format = "#S"
            }
        }
        text_multi = {
            visible = "[And(DoctrineGroupType.IsOnlyForMainRite, Not(Rite.IsMain))]"
            layoutpolicy_horizontal = expanding
            text = "DI_fe_main_rite_only"
            default_format = "#low"
        }
        hbox = {
            layoutpolicy_horizontal = expanding
            spacing = 8
            icon_doctrine = {
                size = { 50 50 }
                visible = "[DoctrineGroupType.HasIcon]"
                texture = "[DoctrineGroupType.GetIcon]"
            }
            flowcontainer = {
                ignoreinvisible = yes
                block "DI_fe_group_icons" {}
            }
            divider_light = { layoutpolicy_vertical = expanding }
            vbox = {
                layoutpolicy_horizontal = expanding
                spacing = 2
                ignoreinvisible = yes
                block "DI_fe_group_rows" {}
            }
        }
    }

    type DI_fe_selected_doctrine_icon = icon_doctrine {
        size = { 50 50 }
        visible = "[And(Not(DoctrineGroupType.HasIcon), Rite.HasDoctrine(DoctrineType.Self))]"
        texture = "[DoctrineType.GetIcon]"
    }

    # One catalogue scan, only when Overflow is expanded. Unknown definitions
    # remain editable without generating a group-by-catalogue widget product.
    type DI_fe_overflow_category = vbox {
        layoutpolicy_horizontal = expanding
        oncreate = "[BindFoldOutContext]"
        oncreate = "[PdxGuiFoldOut.Fold]"
        button_expandable_toggle_field = {
            blockoverride "text" {
                text = "DI_fe_overflow"
                default_format = "#T"
            }
        }
        vbox = {
            layoutpolicy_horizontal = expanding
            visible = "[PdxGuiFoldOut.IsUnfolded]"
            spacing = 4
            text_multi = {
                layoutpolicy_horizontal = expanding
                text = "DI_fe_overflow_help"
                default_format = "#low"
            }
            vbox = {
                layoutpolicy_horizontal = expanding
                ignoreinvisible = yes
                datamodel = "[DataModelFirst(GetAllDoctrineTypes, Select_int32(PdxGuiFoldOut.IsUnfolded, GetDataModelSize(GetAllDoctrineTypes), '(int32)0'))]"
                item = {
                    vbox = {
                        layoutpolicy_horizontal = expanding
                        datacontext = "[DoctrineType.GetGroup]"
                        datamodel = "[DataModelFirst(GetAllTenetTypes, Select_int32(And(DoctrineType.IsVisible, GetScriptedGui('DI_fe_uncatalogued_doctrine_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('doctrine', DoctrineType.MakeScope).End)), '(int32)1', '(int32)0'))]"
                        item = {
                            vbox = {
                                layoutpolicy_horizontal = expanding
                                spacing = 2
                                margin = { 10 4 }
                                text_single = {
                                    text = "[DoctrineGroupType.GetName(Faith.Self)]"
                                    default_format = "#S"
                                }
                                text_multi = {
                                    layoutpolicy_horizontal = expanding
                                    visible = "[And(DoctrineGroupType.IsOnlyForMainRite, Not(Rite.IsMain))]"
                                    text = "DI_fe_main_rite_only"
                                    default_format = "#low"
                                }
                                DI_fe_doctrine_row = {}
                            }
                        }
                    }
                }
            }
        }
    }

    type DI_fe_doctrine_row = button_standard_hover {
        layoutpolicy_horizontal = expanding
        min_height = 30
        visible = "[And(ObjectsEqual(DoctrineType.GetGroup, DoctrineGroupType.Self), Or3(DoctrineType.IsVisible, ObjectsEqual(DoctrineGroupType.Self, GetDoctrineGroupType('doctrine_head_of_faith')), ObjectsEqual(DoctrineGroupType.Self, GetDoctrineGroupType('special_tolerance'))))]"
        enabled = "[And(GetScriptedGui('DI_fe_target_current_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End), Or(Rite.IsMain, Not(DoctrineType.GetGroup.IsOnlyForMainRite)))]"
        onclick = "[GetScriptedGui('DI_fe_set_doctrine_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_rite', Rite.MakeScope).AddScope('doctrine', DoctrineType.MakeScope).AddScope('main_only', MakeScopeFlag(Select_CString(DoctrineType.GetGroup.IsOnlyForMainRite, 'yes', 'no'))).End)]"
        onrightclick = "[GetScriptedGui('DI_fe_remove_doctrine_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_rite', Rite.MakeScope).AddScope('doctrine', DoctrineType.MakeScope).AddScope('main_only', MakeScopeFlag(Select_CString(DoctrineType.GetGroup.IsOnlyForMainRite, 'yes', 'no'))).End)]"
        button_ignore = none
        tooltip = "DI_fe_doctrine_tooltip"
        using = tooltip_ne
        background = {
            using = Background_Area
            alpha = 0.6
        }
        background = {
            visible = "[Rite.GetFaith.GetMainRite.HasDoctrine(DoctrineType.Self)]"
            using = Status_Good
            using = Color_Blue
            alpha = 0.25
        }
        background = {
            visible = "[And(Rite.HasDoctrine(DoctrineType.Self), Not(Rite.GetFaith.GetMainRite.HasDoctrine(DoctrineType.Self)))]"
            using = Status_Good
            using = Color_Bright_Yellow
            alpha = 0.25
        }
        hbox = {
            layoutpolicy_horizontal = expanding
            margin = { 6 3 }
            spacing = 8
            alwaystransparent = yes
            text_multi = {
                layoutpolicy_horizontal = expanding
                autoresize = no
                min_height = 24
                align = vcenter|nobaseline
                text = "[DoctrineType.GetNameNoTooltip(Faith.Self)]"
                default_format = "#high"
            }
            text_single = {
                visible = "[Rite.HasDoctrine(DoctrineType.Self)]"
                text = "DI_fe_current"
                default_format = "#high"
            }
            text_single = {
                visible = "[And(Rite.GetFaith.GetMainRite.HasDoctrine(DoctrineType.Self), Not(Rite.HasDoctrine(DoctrineType.Self)))]"
                text = "DI_fe_mainline"
                default_format = "#low"
            }
        }
    }
}
