# Share the faith editor picker, with immediate character conversion on click.
template DI_CE_Religion_Tab {
    vbox = {
        name = "religion_tab"
        visible = "[GetVariableSystem.HasValue('char_editor_tab', 'religion')]"
        layoutpolicy_horizontal = expanding
        margin = { 20 5 }
        spacing = 6
        using = Animation_Tab_Switch
        text_multi = {
            layoutpolicy_horizontal = expanding
            text = "DI_ce_rite_picker_help"
        }
        widget = {
            size = { 540 300 }
            DI_fe_rite_picker = {
                size = { 100% 100% }
                blockoverride "DI_rite_picker_model" {
                    datamodel = "[DataModelFirst(GetGlobalList('DI_religion_list'), Select_int32(GetVariableSystem.HasValue('char_editor_tab', 'religion'), GetDataModelSize(GetGlobalList('DI_religion_list')), '(int32)0'))]"
                }
                blockoverride "DI_rite_picker_religion_selection" {
                    down = "[And(Not(GetPlayer.MakeScope.Var('DI_misc_variables_story').Var('DI_pinned_char_var').IsSet), ObjectsEqual(Religion.Self, GetPlayer.GetRite.GetFaith.GetReligion))]"
                }
                blockoverride "DI_rite_picker_faith_selection" {
                    down = "[And(Not(GetPlayer.MakeScope.Var('DI_misc_variables_story').Var('DI_pinned_char_var').IsSet), ObjectsEqual(Faith.Self, GetPlayer.GetRite.GetFaith))]"
                }
                blockoverride "DI_rite_picker_action" {
                    enabled = "[GetScriptedGui('DI_ce_convert_to_rite_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_rite', Rite.MakeScope).End)]"
                    down = "[And(Not(GetPlayer.MakeScope.Var('DI_misc_variables_story').Var('DI_pinned_char_var').IsSet), ObjectsEqual(Rite.Self, GetPlayer.GetRite))]"
                    tooltip = "DI_ce_rite_picker_tt"
                    using = tooltip_ne
                    onclick = "[GetScriptedGui('DI_ce_convert_to_rite_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_rite', Rite.MakeScope).End)]"
                }
            }
        }
    }
}

template DI_CE_Religion_Tabs
{
    vbox = {
        layoutpolicy_horizontal = expanding
        layoutpolicy_vertical = expanding

        margin = { 10 10 }
        spacing = 10
        visible = "[GetVariableSystem.HasValue('char_editor_tab', 'religion')]"

        hbox = {
            spacing = 10
            button_standard = {
                size = {200 35}
                text =  DI_change_to_my_religion
                tooltip =  DI_change_to_my_religion_tt
                onclick = "[GetScriptedGui('DI_change_myreligion').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            }

            button_standard = {
                size = {200 35}
                text = DI_change_counties_to_my_religion
                tooltip = DI_change_counties_to_my_religion_tt
                onclick = "[GetScriptedGui('DI_change_myreligion_county').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            }
        }

        expand = {}
    }
}