window = {
    name = "DI_religion_window"
    parentanchor = top|right
    position = { -600 100 }
    size = { 500 700 }
    layer = windows_layer
    filter_mouse = all
    allow_outside = yes
    alwaystransparent = no

    using = Window_Background
    using = Window_Decoration
    movable = yes

    datacontext = "[GetVariableSystem]"

    visible = "[GetVariableSystem.Exists('DI_religion_window_visible')]"

    state = {
        name = _show
        using = Animation_FadeIn_Quick

        on_start = "[GetScriptedGui('DI_religion_list_load').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        on_finish = "[PdxGuiWidget.StackTop]"
    }

    state = {
        name = _hide
        using = Animation_FadeOut_Quick
    }

    vbox = {
        restrictparent_min = yes
        using = Window_Margins

        header_pattern = {
            layoutpolicy_horizontal = expanding


            blockoverride "header_text"
            {
                text = DI_religion_menu_title
            }

            blockoverride "button_close"
            {
                onclick = "[GetVariableSystem.Toggle('DI_religion_window_visible')]"

            }
        }

        DI_religion_scrollbox = {
            datacontext = "[GetPlayer.MakeScope.Var('DI_primary_character').Char]"
            visible = "[GetVariableSystem.HasValue('DI_religion_window_mode', 'pinned_character')]"

            blockoverride "footer" {}
            blockoverride "onclick" {
                onclick = "[GetScriptedGui('DI_PC_religion_change').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_faith', Faith.MakeScope).AddScope('target', Character.MakeScope).End)]"
            }
            blockoverride "rite_onclick" {
                onclick = "[GetScriptedGui('DI_PC_rite_change').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_rite', Rite.MakeScope).AddScope('target', Character.MakeScope).End)]"
            }
        }

        DI_religion_scrollbox = {
            visible = "[GetVariableSystem.HasValue('DI_religion_window_mode', 'char_spawner')]"

            blockoverride "footer" {}
            blockoverride "onclick" {
                onclick = "[GetScriptedGui('DI_char_spawner_select_faith').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_faith', Faith.MakeScope).End)]"
                onclick = "[GetVariableSystem.Toggle('DI_religion_window_visible')]"
            }
            blockoverride "rite_onclick" {
                onclick = "[GetScriptedGui('DI_char_spawner_select_rite').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_rite', Rite.MakeScope).End)]"
                onclick = "[GetVariableSystem.Toggle('DI_religion_window_visible')]"
            }
        }
    }
}

types DIReligionShared
{
    type DI_religion_scrollbox = vbox
    {
        layoutpolicy_vertical = expanding
        layoutpolicy_horizontal = expanding

        scrollbox = {
            layoutpolicy_vertical = expanding
            layoutpolicy_horizontal = expanding
            minimumsize = { 400 100% }

            blockoverride "scrollbox_content"
            {
                vbox = {
                    name = "religions"
                    layoutpolicy_horizontal = expanding
                    datamodel = "[GetGlobalList('DI_religion_list')]"

                    item = {
                        vbox = {
                            name = "religion"
                            datacontext = "[Scope.Religion]"
                            layoutpolicy_horizontal = expanding

                            hbox = {
                                layoutpolicy_horizontal = expanding
                                tooltip = "RULER_DESIGNER_LIST_RELIGION_ENTRY_SELECT_TOOLTIP"

                                button_standard_hover = {
                                    layoutpolicy_horizontal = expanding
                                    onclick = "[VariableSystem.Toggle(ConcatIfNeitherEmpty(Religion.GetNameNoTooltip, '_children_visible'))]"

                                    hbox = {
                                        margin = { 5 0 }
                                        spacing = 10

                                        button_list_expand = {
                                            checked = "[GetVariableSystem.Exists(ConcatIfNeitherEmpty(Religion.GetNameNoTooltip, '_children_visible'))]"
                                            onclick = "[VariableSystem.Toggle(ConcatIfNeitherEmpty(Religion.GetNameNoTooltip, '_children_visible'))]"
                                        }

                                        text_single = {
                                            layoutpolicy_horizontal = expanding
                                            text = "[Religion.GetNameNoTooltip]"
                                            size = { 0 40 }
                                            align = nobaseline
                                            default_format = "#clickable"
                                            autoresize = no
                                        }
                                    }
                                }
                            }

                            vbox = {
                                name = "faiths"
                                datamodel = "[Religion.GetFaiths]"
                                visible = "[GetVariableSystem.Exists(ConcatIfNeitherEmpty(Religion.GetNameNoTooltip, '_children_visible'))]"
                                layoutpolicy_horizontal = expanding

                                item = {
                                    vbox = {
                                        layoutpolicy_horizontal = expanding

                                        hbox = {
                                            layoutpolicy_horizontal = expanding

                                            # 1.20: unfold the faith to pick one of its rites
                                            button_list_expand = {
                                                tooltip = DI_religion_show_rites_tt
                                                checked = "[GetVariableSystem.Exists(ConcatIfNeitherEmpty(Faith.GetNameNoTooltip, '_rites_visible'))]"
                                                onclick = "[GetVariableSystem.Toggle(ConcatIfNeitherEmpty(Faith.GetNameNoTooltip, '_rites_visible'))]"
                                            }

                                            button_standard_hover = {
                                                name = "faith_item"
                                                layoutpolicy_horizontal = expanding
                                                size = { 0 55 }
                                                tooltip = DI_religion_faith_main_rite_tt
                                                using = Button_Select_Faith
                                                block "onclick"
                                                {
                                                    onclick = "[GetScriptedGui('DI_religion_change').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_faith', Faith.MakeScope).End)]"
                                                }

                                                hbox = {
                                                    margin = { 5 0 }
                                                    margin_left = 10
                                                    spacing = 10

                                                    icon = {
                                                        size = { 50 50 }
                                                        texture = "[Faith.GetIcon]"
                                                    }

                                                    text_single = {
                                                        layoutpolicy_horizontal = expanding
                                                        text = "[Faith.GetNameNoTooltip]"
                                                        default_format = "#clickable"
                                                        autoresize = no
                                                    }
                                                }
                                            }
                                        }

                                        vbox = {
                                            name = "rites"
                                            layoutpolicy_horizontal = expanding
                                            visible = "[GetVariableSystem.Exists(ConcatIfNeitherEmpty(Faith.GetNameNoTooltip, '_rites_visible'))]"
                                            datamodel = "[Faith.GetRites]"

                                            item = {
                                                button_standard_hover = {
                                                    name = "rite_item"
                                                    layoutpolicy_horizontal = expanding
                                                    size = { 0 40 }
                                                    enabled = "[Rite.IsValid]"
                                                    block "rite_onclick"
                                                    {
                                                        onclick = "[GetScriptedGui('DI_rite_change').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_rite', Rite.MakeScope).End)]"
                                                    }

                                                    hbox = {
                                                        margin = { 5 0 }
                                                        margin_left = 70
                                                        spacing = 8

                                                        icon = {
                                                            size = { 32 32 }
                                                            texture = "[Rite.GetIcon]"
                                                        }

                                                        text_single = {
                                                            layoutpolicy_horizontal = expanding
                                                            text = "[Rite.GetNameNoTooltip]"
                                                            default_format = "#clickable"
                                                            autoresize = no
                                                        }

                                                        text_single = {
                                                            visible = "[Rite.IsMain]"
                                                            text = DI_religion_main_rite
                                                            default_format = "#low"
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        block "footer"
        {
            hbox = {
                layoutpolicy_horizontal = expanding
                spacing = 10
                margin = { 10 10 }
                button_standard = {
                    size = {200 35}
                    text = DI_change_to_my_religion
                    tooltip = DI_change_to_my_religion_tt
                    onclick = "[GetScriptedGui('DI_change_myreligion').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                }

                button_standard = {
                    size = {200 35}
                    text = DI_change_counties_to_my_religion
                    tooltip = DI_change_counties_to_my_religion_tt
                    onclick = "[GetScriptedGui('DI_change_myreligion_county').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                }
            }
        }
    }
}
