types DI_cc_conversion_types {
    type DI_cc_conversion_panel = widget {
        layoutpolicy_horizontal = expanding
        layoutpolicy_vertical = expanding
        size = { 0 0 }
        visible = "[GetVariableSystem.HasValue('culture_view_tabs', 'convert')]"

        # Bound the list above the reserved action area instead of letting its
        # content determine the conversion panel's preferred height.
        vbox = {
            size = { 100% 100% }
            margin_bottom = 210
            ignoreinvisible = yes
            text_multi = {
                layoutpolicy_horizontal = expanding
                align = center
                text = "DI_cc_conversion_destination"
                default_format = "#high"
            }
            text_multi = {
                margin_left = 16
                layoutpolicy_horizontal = expanding
                text = "DI_cc_conversion_help"
                default_format = "#low"
            }
            hbox = {
                layoutpolicy_horizontal = expanding
                spacing = 6
                button_standard = {
                    layoutpolicy_horizontal = expanding
                    text = "DI_cc_use_primary_culture"
                    enabled = "[GetPlayer.MakeScope.Var('DI_innovation_selected_char').Char.GetCulture.IsValid]"
                    onclick = "[GetScriptedGui('DI_cc_select_conversion_culture_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_culture', GetPlayer.MakeScope.Var('DI_innovation_selected_char').Char.GetCulture.MakeScope).End)]"
                }
                button_standard = {
                    layoutpolicy_horizontal = expanding
                    text = "DI_cc_use_secondary_culture"
                    enabled = "[GetPlayer.MakeScope.Var('DI_innovation_selected_char_copy').Char.GetCulture.IsValid]"
                    onclick = "[GetScriptedGui('DI_cc_select_conversion_culture_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_culture', GetPlayer.MakeScope.Var('DI_innovation_selected_char_copy').Char.GetCulture.MakeScope).End)]"
                }
                button_standard = {
                    layoutpolicy_horizontal = expanding
                    text = "DI_cc_use_player_culture"
                    enabled = "[GetPlayer.GetCulture.IsValid]"
                    onclick = "[GetScriptedGui('DI_cc_select_conversion_culture_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_culture', GetPlayer.GetCulture.MakeScope).End)]"
                }
            }
            # Allocate remaining panel height without letting list contents size the panel.
            widget = {
                layoutpolicy_horizontal = expanding
                layoutpolicy_vertical = expanding
                size = { 0 0 }
                minimumsize = { 0 0 }
                DI_culture_scrollbox = {
                    size = { 100% 100% }
                    blockoverride "DI_culture_picker_category_selection" {
                        down = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cc_conversion_culture').Culture.GetHeritage)]"
                    }
                    blockoverride "DI_culture_picker_selection" {
                        down = "[ObjectsEqual(Culture.Self, GetPlayer.MakeScope.Var('DI_cc_conversion_culture').Culture)]"
                    }
                    blockoverride "onclick" {
                        onclick = "[GetScriptedGui('DI_cc_select_conversion_culture_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_culture', Culture.MakeScope).End)]"
                    }
                }
            }
        }

        # This footer stays inside the panel's bottom edge at every resolution.
        widget = {
            parentanchor = bottom|left
            size = { 100% 200 }
            vbox = {
                size = { 100% 100% }
                ignoreinvisible = yes
                hbox = {
                    layoutpolicy_horizontal = expanding
                    button_tab = {
                        layoutpolicy_horizontal = expanding
                        text = "DI_people"
                        down = "[Not(GetVariableSystem.Exists('DI_cc_conversion_area'))]"
                        onclick = "[GetVariableSystem.Clear('DI_cc_conversion_area')]"
                    }
                    button_tab = {
                        layoutpolicy_horizontal = expanding
                        text = "DI_counties"
                        down = "[GetVariableSystem.HasValue('DI_cc_conversion_area', 'counties')]"
                        onclick = "[GetVariableSystem.Set('DI_cc_conversion_area', 'counties')]"
                    }
                    button_tab = {
                        layoutpolicy_horizontal = expanding
                        text = "DI_sub_realm"
                        down = "[GetVariableSystem.HasValue('DI_cc_conversion_area', 'sub_realm')]"
                        onclick = "[GetVariableSystem.Set('DI_cc_conversion_area', 'sub_realm')]"
                    }
                    button_tab = {
                        layoutpolicy_horizontal = expanding
                        text = "DI_realm"
                        down = "[GetVariableSystem.HasValue('DI_cc_conversion_area', 'realm')]"
                        onclick = "[GetVariableSystem.Set('DI_cc_conversion_area', 'realm')]"
                    }
                }
                vbox = {
                    layoutpolicy_horizontal = expanding
                    visible = "[Not(GetVariableSystem.Exists('DI_cc_conversion_area'))]"
                    spacing = 6
                    text_multi = { 
                        margin_left = 16
                        layoutpolicy_horizontal = expanding 
                        text = "DI_cc_conversion_people_help" 
                    }
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 6
                        button_standard = {
                            layoutpolicy_horizontal = expanding
                            text = "DI_cc_convert_people_selected_picked"
                            tooltip = "DI_cc_convert_people_selected_picked_tt"
                            using = tooltip_ne
                            enabled = "[GetScriptedGui('DI_cc_convert_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('people')).AddScope('audience', MakeScopeFlag('selected')).End)]"
                            onclick = "[GetScriptedGui('DI_cc_convert_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('people')).AddScope('audience', MakeScopeFlag('selected')).End)]"
                        }
                        button_standard = {
                            layoutpolicy_horizontal = expanding
                            text = "DI_cc_convert_people_pinned_picked"
                            tooltip = "DI_cc_convert_people_pinned_picked_tt"
                            using = tooltip_ne
                            enabled = "[GetScriptedGui('DI_cc_convert_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('people')).AddScope('audience', MakeScopeFlag('pinned')).End)]"
                            onclick = "[GetScriptedGui('DI_cc_convert_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('people')).AddScope('audience', MakeScopeFlag('pinned')).End)]"
                        }
                    }
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 6
                        button_standard = {
                            layoutpolicy_horizontal = expanding
                            text = "DI_cc_convert_people_courtiers_picked"
                            tooltip = "DI_cc_convert_people_courtiers_picked_tt"
                            using = tooltip_ne
                            enabled = "[GetScriptedGui('DI_cc_convert_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('people')).AddScope('audience', MakeScopeFlag('courtiers')).End)]"
                            onclick = "[GetScriptedGui('DI_cc_convert_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('people')).AddScope('audience', MakeScopeFlag('courtiers')).End)]"
                        }
                        button_standard = {
                            layoutpolicy_horizontal = expanding
                            text = "DI_cc_convert_people_vassals_picked"
                            tooltip = "DI_cc_convert_people_vassals_picked_tt"
                            using = tooltip_ne
                            enabled = "[GetScriptedGui('DI_cc_convert_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('people')).AddScope('audience', MakeScopeFlag('vassals')).End)]"
                            onclick = "[GetScriptedGui('DI_cc_convert_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('people')).AddScope('audience', MakeScopeFlag('vassals')).End)]"
                        }
                    }
                }
                vbox = {
                    layoutpolicy_horizontal = expanding
                    visible = "[GetVariableSystem.HasValue('DI_cc_conversion_area', 'counties')]"
                    spacing = 6
                    text_multi = { 
                        margin_left = 16
                        layoutpolicy_horizontal = expanding 
                        text = "DI_cc_conversion_counties_help" 
                    }
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 6
                        button_standard = {
                            layoutpolicy_horizontal = expanding
                            text = "DI_cc_convert_counties_selected_picked"
                            tooltip = "DI_cc_convert_counties_selected_picked_tt"
                            using = tooltip_ne
                            enabled = "[GetScriptedGui('DI_cc_convert_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('counties')).AddScope('audience', MakeScopeFlag('selected')).End)]"
                            onclick = "[GetScriptedGui('DI_cc_convert_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('counties')).AddScope('audience', MakeScopeFlag('selected')).End)]"
                        }
                        button_standard = {
                            layoutpolicy_horizontal = expanding
                            text = "DI_cc_convert_counties_pinned_picked"
                            tooltip = "DI_cc_convert_counties_pinned_picked_tt"
                            using = tooltip_ne
                            enabled = "[GetScriptedGui('DI_cc_convert_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('counties')).AddScope('audience', MakeScopeFlag('pinned')).End)]"
                            onclick = "[GetScriptedGui('DI_cc_convert_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('counties')).AddScope('audience', MakeScopeFlag('pinned')).End)]"
                        }
                    }
                }
                vbox = {
                    layoutpolicy_horizontal = expanding
                    visible = "[GetVariableSystem.HasValue('DI_cc_conversion_area', 'sub_realm')]"
                    spacing = 6
                    text_multi = { 
                        margin_left = 16
                        layoutpolicy_horizontal = expanding 
                        text = "DI_cc_conversion_sub_realm_help" 
                    }
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 6
                        button_standard = {
                            layoutpolicy_horizontal = expanding
                            text = "DI_cc_convert_sub_realm_selected_picked"
                            tooltip = "DI_cc_convert_sub_realm_selected_picked_tt"
                            using = tooltip_ne
                            enabled = "[GetScriptedGui('DI_cc_convert_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('sub_realm')).AddScope('audience', MakeScopeFlag('selected')).End)]"
                            onclick = "[GetScriptedGui('DI_cc_convert_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('sub_realm')).AddScope('audience', MakeScopeFlag('selected')).End)]"
                        }
                        button_standard = {
                            layoutpolicy_horizontal = expanding
                            text = "DI_cc_convert_sub_realm_pinned_picked"
                            tooltip = "DI_cc_convert_sub_realm_pinned_picked_tt"
                            using = tooltip_ne
                            enabled = "[GetScriptedGui('DI_cc_convert_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('sub_realm')).AddScope('audience', MakeScopeFlag('pinned')).End)]"
                            onclick = "[GetScriptedGui('DI_cc_convert_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('sub_realm')).AddScope('audience', MakeScopeFlag('pinned')).End)]"
                        }
                    }
                }
                vbox = {
                    layoutpolicy_horizontal = expanding
                    visible = "[GetVariableSystem.HasValue('DI_cc_conversion_area', 'realm')]"
                    spacing = 6
                    text_multi = { 
                        margin_left = 16
                        layoutpolicy_horizontal = expanding 
                        text = "DI_cc_conversion_realm_help" 
                    }
                    hbox = {
                        layoutpolicy_horizontal = expanding
                        spacing = 6
                        button_standard = {
                            layoutpolicy_horizontal = expanding
                            text = "DI_cc_convert_realm_selected_picked"
                            tooltip = "DI_cc_convert_realm_selected_picked_tt"
                            using = tooltip_ne
                            enabled = "[GetScriptedGui('DI_cc_convert_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('realm')).AddScope('audience', MakeScopeFlag('selected')).End)]"
                            onclick = "[GetScriptedGui('DI_cc_convert_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('realm')).AddScope('audience', MakeScopeFlag('selected')).End)]"
                        }
                        button_standard = {
                            layoutpolicy_horizontal = expanding
                            text = "DI_cc_convert_realm_pinned_picked"
                            tooltip = "DI_cc_convert_realm_pinned_picked_tt"
                            using = tooltip_ne
                            enabled = "[GetScriptedGui('DI_cc_convert_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('realm')).AddScope('audience', MakeScopeFlag('pinned')).End)]"
                            onclick = "[GetScriptedGui('DI_cc_convert_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('area', MakeScopeFlag('realm')).AddScope('audience', MakeScopeFlag('pinned')).End)]"
                        }
                    }
                }
                expand = {}
            }
        }
    }
}
