types DI_Innovation_Types
{
    type DI_ce_innovation_grid = fixedgridbox {
        parentanchor = top|left
        widgetanchor = top|left
        flipdirection = yes
        addcolumn = 311
        addrow = 84
        datamodel_wrap = 2
        item = {
            DI_picker_selection_card = {
                datacontext = "[Scope.CultureInnovationType]"
                down = "[GetScriptedGui('DI_ce_innovation_selected_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('innovation', CultureInnovationType.MakeScope).End)]"
                onclick = "[GetScriptedGui('DI_ce_add_innovation_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('innovation', CultureInnovationType.MakeScope).End)]"
                onrightclick = "[GetScriptedGui('DI_ce_remove_innovation_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('innovation', CultureInnovationType.MakeScope).End)]"
                tooltipwidget = { using = DI_culture_innovation_tooltip }
                blockoverride "DI_card_highlight" { visible = "[GetScriptedGui('DI_ce_innovation_selected_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('innovation', CultureInnovationType.MakeScope).End)]" }
                blockoverride "DI_card_check" { visible = "[GetScriptedGui('DI_ce_innovation_selected_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('innovation', CultureInnovationType.MakeScope).End)]" }
                blockoverride "DI_card_image" {
                    DI_icon_innovation = { parentanchor = center alwaystransparent = yes }
                }
                blockoverride "DI_card_text" { text = "[CultureInnovationType.GetName]" }
            }
        }
    }
}
