                                        text_label_left = { layoutpolicy_horizontal = expanding text = "DI_tradition_use_adventurers" }
                                        hbox = {
                                            layoutpolicy_horizontal = expanding
                                            DI_cd_tradition_use_grid = { datamodel = "[GetGlobalList(ConcatIfNeitherEmpty(ConcatIfNeitherEmpty('DI_tradition_picker_', GetVariableSystem.Get('DI_cd_tradition_tab')), '_adventurers'))]" }
                                            expand = {}
                                        }
                                    }
                                    vbox = {
                                        layoutpolicy_horizontal = expanding
                                        spacing = 6
                                        visible = "[GreaterThan_int32(GetDataModelSize(GetGlobalList(ConcatIfNeitherEmpty(ConcatIfNeitherEmpty('DI_tradition_picker_', GetVariableSystem.Get('DI_cd_tradition_tab')), '_general'))), '(int32)0')]"
                                        text_label_left = { layoutpolicy_horizontal = expanding text = "DI_tradition_use_general" }
                                        hbox = {
                                            layoutpolicy_horizontal = expanding
                                            DI_cd_tradition_use_grid = { datamodel = "[GetGlobalList(ConcatIfNeitherEmpty(ConcatIfNeitherEmpty('DI_tradition_picker_', GetVariableSystem.Get('DI_cd_tradition_tab')), '_general'))]" }
                                            expand = {}
