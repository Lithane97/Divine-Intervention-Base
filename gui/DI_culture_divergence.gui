                                    spacing = 8
                                    visible = "[GreaterThan_int32(GetDataModelSize(GetGlobalList(ConcatIfNeitherEmpty(ConcatIfNeitherEmpty('DI_cd_innovations_', GetVariableSystem.Get('DI_cd_innovation_tab')), '_regional'))), '(int32)0')]"
                                    text_label_left = { layoutpolicy_horizontal = expanding text = "culture_group_regional" }
                                    DI_cd_innovation_grid = { datamodel = "[GetGlobalList(ConcatIfNeitherEmpty(ConcatIfNeitherEmpty('DI_cd_innovations_', GetVariableSystem.Get('DI_cd_innovation_tab')), '_regional'))]" }
                                }
                                vbox = {
                                    layoutpolicy_horizontal = expanding
                                    spacing = 8
                                    visible = "[GreaterThan_int32(GetDataModelSize(GetGlobalList(ConcatIfNeitherEmpty(ConcatIfNeitherEmpty('DI_cd_innovations_', GetVariableSystem.Get('DI_cd_innovation_tab')), '_other'))), '(int32)0')]"
                                    text_label_left = { layoutpolicy_horizontal = expanding text = "DI_cd_innovation_other" }
                                    DI_cd_innovation_grid = { datamodel = "[GetGlobalList(ConcatIfNeitherEmpty(ConcatIfNeitherEmpty('DI_cd_innovations_', GetVariableSystem.Get('DI_cd_innovation_tab')), '_other'))]" }
                                }
                                vbox = {
                                    layoutpolicy_horizontal = expanding
                                    spacing = 8
                                    visible = "[GreaterThan_int32(GetDataModelSize(GetGlobalList(ConcatIfNeitherEmpty(ConcatIfNeitherEmpty('DI_cd_innovations_', GetVariableSystem.Get('DI_cd_innovation_tab')), '_silk_road'))), '(int32)0')]"
                                    text_label_left = { layoutpolicy_horizontal = expanding text = "game_concept_silk_road_innovations" }
                                    DI_cd_innovation_grid = { datamodel = "[GetGlobalList(ConcatIfNeitherEmpty(ConcatIfNeitherEmpty('DI_cd_innovations_', GetVariableSystem.Get('DI_cd_innovation_tab')), '_silk_road'))]" }
                                }
                            }
                        }
                    }
                }

                text_multi = {
                    name = "DI_cd_traditions_other_empty_message"
                    parentanchor = center
                    widgetanchor = center
                    size = { 90% 100 }
                    autoresize = no
                    align = center|nobaseline
                    alwaystransparent = yes
                    default_format = "#high"
                    visible = "[And(And(GetVariableSystem.HasValue('DI_cd_tab', 'traditions'), GetVariableSystem.HasValue('DI_cd_tradition_tab', 'other')), EqualTo_int32(GetDataModelSize(GetGlobalList('DI_tradition_picker_other')), '(int32)0'))]"
                    text = "DI_tradition_picker_other_empty"
                }

                text_multi = {
                    name = "DI_cd_innovations_other_empty_message"
                    parentanchor = center
                    widgetanchor = center
                    size = { 90% 100 }
                    autoresize = no
                    align = center|nobaseline
                    alwaystransparent = yes
                    default_format = "#high"
                    visible = "[And(And(GetVariableSystem.HasValue('DI_cd_tab', 'innovations'), GetVariableSystem.HasValue('DI_cd_innovation_tab', 'other')), And(And(And(And(EqualTo_int32(GetDataModelSize(GetGlobalList('DI_cd_innovations_other_military')), '(int32)0'), EqualTo_int32(GetDataModelSize(GetGlobalList('DI_cd_innovations_other_civic')), '(int32)0')), EqualTo_int32(GetDataModelSize(GetGlobalList('DI_cd_innovations_other_regional')), '(int32)0')), EqualTo_int32(GetDataModelSize(GetGlobalList('DI_cd_innovations_other_other')), '(int32)0')), EqualTo_int32(GetDataModelSize(GetGlobalList('DI_cd_innovations_other_silk_road')), '(int32)0')))]"
                    text = "DI_cd_innovations_other_empty"
                }
            }
            vbox = {
                name = "DI_cd_footer_content"
                layoutpolicy_horizontal = expanding
                margin_left = 24
                margin_right = 24
                spacing = 10
                divider_light = { layoutpolicy_horizontal = expanding }
                text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 840 text = "DI_cd_scope_help" default_format = "#low" }
                hbox = {
                    layoutpolicy_horizontal = expanding
                    spacing = 12
                    margin_bottom = 18
                    DI_cd_checked_button = { size = { 380 40 } text = "DI_cd_adoption"
                        down = "[Not(GetPlayer.MakeScope.Var('DI_cd_keep_founder_culture').IsSet)]" onclick = "[GetScriptedGui('DI_cd_toggle_adoption_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        blockoverride "DI_cd_selected_check" { visible = "[Not(GetPlayer.MakeScope.Var('DI_cd_keep_founder_culture').IsSet)]" }
                    }
                    expand = {}
                    button_standard = { size = { 160 40 } text = "DI_cd_cancel" onclick = "[GetScriptedGui('DI_cd_cancel_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                    button_primary = { size = { 220 40 } text = "DI_cd_create" tooltip = "DI_cd_finalize_tt" using = tooltip_es
                        enabled = "[GetScriptedGui('DI_cd_finalize_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('DI_cd_finalize_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                }
            }
        }
    }
}

template DI_cd_draft_animation {
    state = { name = _show using = Animation_FadeIn_Quick
        on_start = "[GetVariableSystem.Set('DI_cd_tab', 'names')]"
        on_start = "[GetVariableSystem.Set('DI_cd_pillar_tab', 'ethos')]"
        on_start = "[GetVariableSystem.Set('DI_cd_tradition_tab', 'realm')]"
        on_start = "[GetVariableSystem.Set('DI_cd_innovation_tab', 'tribal')]"
        on_finish = "[PdxGuiWidget.StackTop]"
    }
}


types DI_CultureDraftInnovationTypes
{
    type DI_cd_innovation_grid = fixedgridbox {
        flipdirection = yes addcolumn = 284 addrow = 84 datamodel_wrap = 3
        item = {
            DI_picker_selection_card = {
                datacontext = "[Scope.CultureInnovationType]"
                down = "[GetScriptedGui('DI_cd_innovation_selected_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('innovation', CultureInnovationType.MakeScope).End)]"
                onclick = "[GetScriptedGui('DI_cd_add_innovation_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('innovation', CultureInnovationType.MakeScope).End)]"
                onrightclick = "[GetScriptedGui('DI_cd_remove_innovation_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('innovation', CultureInnovationType.MakeScope).End)]"
                tooltipwidget = { using = DI_culture_innovation_tooltip }
                blockoverride "DI_card_highlight" { visible = "[GetScriptedGui('DI_cd_innovation_selected_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('innovation', CultureInnovationType.MakeScope).End)]" }
                blockoverride "DI_card_check" { visible = "[GetScriptedGui('DI_cd_innovation_selected_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('innovation', CultureInnovationType.MakeScope).End)]" }
                blockoverride "DI_card_image" {
                    DI_icon_innovation = { parentanchor = center alwaystransparent = yes }
                }
                blockoverride "DI_card_text" { text = "[CultureInnovationType.GetName]" }
            }
        }
    }
}


types DI_CultureDraftTraditionUseGridTypes
{
    type DI_cd_tradition_use_grid = fixedgridbox {
        parentanchor = top|left
        widgetanchor = top|left
        flipdirection = yes addcolumn = 284 addrow = 96 datamodel_wrap = 3
        item = {
            DI_picker_tradition_card = {
                datacontext = "[Scope.CultureTradition]"
                down = "[GetScriptedGui('DI_cd_tradition_selected_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tradition', CultureTradition.MakeScope).End)]"
                enabled = "[Or(GetScriptedGui('DI_cd_tradition_selected_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tradition', CultureTradition.MakeScope).End), GetScriptedGui('DI_cd_add_tradition_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tradition', CultureTradition.MakeScope).End))]"
                onclick = "[GetScriptedGui('DI_cd_add_tradition_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tradition', CultureTradition.MakeScope).End)]"
                onrightclick = "[GetScriptedGui('DI_cd_remove_tradition_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tradition', CultureTradition.MakeScope).End)]"
                tooltip = "DI_tradition_picker_tooltip"
                blockoverride "DI_card_highlight" { visible = "[GetScriptedGui('DI_cd_tradition_selected_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tradition', CultureTradition.MakeScope).End)]" }
                blockoverride "DI_card_check" { visible = "[GetScriptedGui('DI_cd_tradition_selected_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tradition', CultureTradition.MakeScope).End)]" }
                blockoverride "DI_card_image" {
                    widget_tradition_icon = {
                        parentanchor = center
                        alwaystransparent = yes
                        block "icon_size" { size = { 102 72 } }
                    }
                }
                blockoverride "DI_card_text" { text = "[CultureTradition.GetNameNoTooltip]" }
            }
        }
    }
}


# Reserve a permanent check column so selecting a button never shifts its label.
types DI_CultureDraftCheckedButtonTypes
{
    type DI_cd_checked_button = button_standard {
        buttonText = {
            text_single = {
                size = { 100% 100% }
                autoresize = no
                margin = { 36 0 }
                align = center|nobaseline
                default_format = "#clickable"
                alwaystransparent = yes
            }
        }
        icon = {
            name = "DI_cd_selection_check"
            parentanchor = right|vcenter
            widgetanchor = right|vcenter
            position = { -8 0 }
            size = { 24 24 }
            texture = "gfx/interface/icons/symbols/icon_check.dds"
            alwaystransparent = yes
            block "DI_cd_selected_check" { visible = no }
        }
    }
}
