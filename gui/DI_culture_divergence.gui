                                    layoutpolicy_horizontal = expanding
                                    spacing = 8
                                    visible = "[GreaterThan_int32(GetDataModelSize(GetGlobalList(ConcatIfNeitherEmpty(ConcatIfNeitherEmpty('DI_cd_innovations_', GetVariableSystem.Get('DI_cd_innovation_tab')), '_military'))), '(int32)0')]"
                                    text_label_left = { layoutpolicy_horizontal = expanding text = "culture_group_military" }
                                    DI_cd_innovation_grid = { datamodel = "[GetGlobalList(ConcatIfNeitherEmpty(ConcatIfNeitherEmpty('DI_cd_innovations_', GetVariableSystem.Get('DI_cd_innovation_tab')), '_military'))]" }
                                }
                                vbox = {
                                    layoutpolicy_horizontal = expanding
                                    spacing = 8
                                    visible = "[GreaterThan_int32(GetDataModelSize(GetGlobalList(ConcatIfNeitherEmpty(ConcatIfNeitherEmpty('DI_cd_innovations_', GetVariableSystem.Get('DI_cd_innovation_tab')), '_civic'))), '(int32)0')]"
                                    text_label_left = { layoutpolicy_horizontal = expanding text = "culture_group_civic" }
                                    DI_cd_innovation_grid = { datamodel = "[GetGlobalList(ConcatIfNeitherEmpty(ConcatIfNeitherEmpty('DI_cd_innovations_', GetVariableSystem.Get('DI_cd_innovation_tab')), '_civic'))]" }
                                }
