window = {
    name = "DI_culture_divergence_window"
    size = { 100% 100% }
    layer = windows_layer
    filter_mouse = all
    alwaystransparent = no
    visible = "[GetPlayer.MakeScope.Var('DI_cd_source').IsSet]"
    datacontext = "[GetPlayer.MakeScope.Var('DI_cd_source').Culture]"
    using = DI_cd_draft_animation
    widget = {
        parentanchor = center
        widgetanchor = center
        size = { 980 88% }
        using = Window_Background
        using = Window_Decoration
        vbox = {
            name = "DI_cd_window_content"
            layoutpolicy_horizontal = expanding
            layoutpolicy_vertical = expanding
            maximumsize = { 900 -1 }
            using = Window_Margins
            spacing = 8
            ignoreinvisible = yes
            header_pattern = {
                layoutpolicy_horizontal = expanding
                blockoverride "header_text" { text = "DI_cd_title" }
                blockoverride "button_close" { onclick = "[GetScriptedGui('DI_cd_cancel_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            }
            vbox = {
                name = "DI_cd_header_content"
                layoutpolicy_horizontal = expanding
                margin_left = 24
                margin_right = 24
                spacing = 8
                ignoreinvisible = yes
                vbox = {
                    name = "DI_cd_parent_summary"
                    layoutpolicy_horizontal = expanding
                    ignoreinvisible = yes
                    spacing = 4
                    margin = { 12 8 }
                    background = { using = Background_Area_Dark }
                    text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 820 text = "DI_cd_source" default_format = "#high" }
                    text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 820 visible = "[GetPlayer.MakeScope.Var('DI_cd_secondary').IsSet]" text = "DI_ch_secondary" default_format = "#high" }
                }
                text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 840 text = "DI_cd_help" default_format = "#low" }
            }
            hbox = {
                layoutpolicy_horizontal = expanding
                margin_left = 12
                margin_right = 12
                button_tab = { layoutpolicy_horizontal = expanding text = "DI_cd_names"
                    onclick = "[GetVariableSystem.Set('DI_cd_tab', 'names')]"
                    down = "[GetVariableSystem.HasValue('DI_cd_tab', 'names')]" }
                button_tab = { layoutpolicy_horizontal = expanding text = "DI_cd_pillars"
                    onclick = "[GetVariableSystem.Set('DI_cd_tab', 'pillars')]"
                    down = "[GetVariableSystem.HasValue('DI_cd_tab', 'pillars')]" }
                button_tab = { layoutpolicy_horizontal = expanding text = "DI_cd_traditions"
                    onclick = "[GetVariableSystem.Set('DI_cd_tab', 'traditions')]"
                    down = "[GetVariableSystem.HasValue('DI_cd_tab', 'traditions')]" }
                button_tab = { layoutpolicy_horizontal = expanding text = "DI_cd_innovations"
                    onclick = "[GetVariableSystem.Set('DI_cd_tab', 'innovations')]"
                    down = "[GetVariableSystem.HasValue('DI_cd_tab', 'innovations')]" }
            }
            vbox = {
                name = "DI_cd_category_tabs"
                layoutpolicy_horizontal = expanding
                ignoreinvisible = yes
                margin = { 8 8 }
                visible = "[Or(Or(GetVariableSystem.HasValue('DI_cd_tab', 'pillars'), GetVariableSystem.HasValue('DI_cd_tab', 'traditions')), GetVariableSystem.HasValue('DI_cd_tab', 'innovations'))]"
                hbox = {
                    layoutpolicy_horizontal = expanding
                    visible = "[GetVariableSystem.HasValue('DI_cd_tab', 'pillars')]"
                    button_tab = { layoutpolicy_horizontal = expanding text = "DI_cd_ethos"
                        onclick = "[GetVariableSystem.Set('DI_cd_pillar_tab', 'ethos')]"
                        down = "[GetVariableSystem.HasValue('DI_cd_pillar_tab', 'ethos')]" }
                    button_tab = { layoutpolicy_horizontal = expanding text = "DI_cd_heritage"
                        onclick = "[GetVariableSystem.Set('DI_cd_pillar_tab', 'heritage')]"
                        down = "[GetVariableSystem.HasValue('DI_cd_pillar_tab', 'heritage')]" }
                    button_tab = { layoutpolicy_horizontal = expanding text = "DI_cd_language"
                        onclick = "[GetVariableSystem.Set('DI_cd_pillar_tab', 'language')]"
                        down = "[GetVariableSystem.HasValue('DI_cd_pillar_tab', 'language')]" }
                    button_tab = { layoutpolicy_horizontal = expanding text = "DI_cd_martial_custom"
                        onclick = "[GetVariableSystem.Set('DI_cd_pillar_tab', 'martial_custom')]"
                        down = "[GetVariableSystem.HasValue('DI_cd_pillar_tab', 'martial_custom')]" }
                }
                hbox = {
                    layoutpolicy_horizontal = expanding
                    visible = "[GetVariableSystem.HasValue('DI_cd_tab', 'traditions')]"
                    button_tab = { layoutpolicy_horizontal = expanding text = "tradition_group_realm"
                        onclick = "[GetVariableSystem.Set('DI_cd_tradition_tab', 'realm')]"
                        down = "[GetVariableSystem.HasValue('DI_cd_tradition_tab', 'realm')]" }
                    button_tab = { layoutpolicy_horizontal = expanding text = "tradition_group_combat"
                        onclick = "[GetVariableSystem.Set('DI_cd_tradition_tab', 'combat')]"
                        down = "[GetVariableSystem.HasValue('DI_cd_tradition_tab', 'combat')]" }
                    button_tab = { layoutpolicy_horizontal = expanding text = "tradition_group_societal"
                        onclick = "[GetVariableSystem.Set('DI_cd_tradition_tab', 'societal')]"
                        down = "[GetVariableSystem.HasValue('DI_cd_tradition_tab', 'societal')]" }
                    button_tab = { layoutpolicy_horizontal = expanding text = "tradition_group_ritual"
                        onclick = "[GetVariableSystem.Set('DI_cd_tradition_tab', 'ritual')]"
                        down = "[GetVariableSystem.HasValue('DI_cd_tradition_tab', 'ritual')]" }
                    button_tab = { layoutpolicy_horizontal = expanding text = "tradition_group_regional"
                        onclick = "[GetVariableSystem.Set('DI_cd_tradition_tab', 'regional')]"
                        down = "[GetVariableSystem.HasValue('DI_cd_tradition_tab', 'regional')]" }
                    button_tab = { layoutpolicy_horizontal = expanding text = "DI_tradition_picker_other"
                        onclick = "[GetVariableSystem.Set('DI_cd_tradition_tab', 'other')]"
                        down = "[GetVariableSystem.HasValue('DI_cd_tradition_tab', 'other')]" }
                }
                hbox = {
                    layoutpolicy_horizontal = expanding
                    visible = "[GetVariableSystem.HasValue('DI_cd_tab', 'innovations')]"
                    button_tab = { layoutpolicy_horizontal = expanding text = "culture_era_tribal"
                        onclick = "[GetVariableSystem.Set('DI_cd_innovation_tab', 'tribal')]"
                        down = "[GetVariableSystem.HasValue('DI_cd_innovation_tab', 'tribal')]" }
                    button_tab = { layoutpolicy_horizontal = expanding text = "culture_era_early_medieval"
                        onclick = "[GetVariableSystem.Set('DI_cd_innovation_tab', 'early_medieval')]"
                        down = "[GetVariableSystem.HasValue('DI_cd_innovation_tab', 'early_medieval')]" }
                    button_tab = { layoutpolicy_horizontal = expanding text = "culture_era_high_medieval"
                        onclick = "[GetVariableSystem.Set('DI_cd_innovation_tab', 'high_medieval')]"
                        down = "[GetVariableSystem.HasValue('DI_cd_innovation_tab', 'high_medieval')]" }
                    button_tab = { layoutpolicy_horizontal = expanding text = "culture_era_late_medieval"
                        onclick = "[GetVariableSystem.Set('DI_cd_innovation_tab', 'late_medieval')]"
                        down = "[GetVariableSystem.HasValue('DI_cd_innovation_tab', 'late_medieval')]" }
                    button_tab = { layoutpolicy_horizontal = expanding text = "DI_cd_innovation_other"
                        onclick = "[GetVariableSystem.Set('DI_cd_innovation_tab', 'other')]"
                        down = "[GetVariableSystem.HasValue('DI_cd_innovation_tab', 'other')]" }
                }
            }
            widget = {
                name = "DI_cd_scroll_area"
                layoutpolicy_horizontal = expanding
                layoutpolicy_vertical = expanding
                scrollbox = {
                    size = { 100% 100% }
                    layoutpolicy_horizontal = expanding
                    layoutpolicy_vertical = expanding
                    blockoverride "scrollbox_content" {
                        vbox = {
                            layoutpolicy_horizontal = expanding
                            spacing = 10
                            ignoreinvisible = yes
                            vbox = {
                                name = "DI_cd_names_content"
                                ignoreinvisible = yes
                                layoutpolicy_horizontal = expanding
                                margin_left = 36
                                margin_right = 36
                                margin_top = 4
                                margin_bottom = 4
                                spacing = 6
                                visible = "[GetVariableSystem.HasValue('DI_cd_tab', 'names')]"
                                vbox = {
                                    name = "DI_cd_name_row"
                                    layoutpolicy_horizontal = expanding
                                    margin = { 16 4 }
                                    spacing = 2
                                    background = { using = Background_Area }
                                    text_label_center = { layoutpolicy_horizontal = expanding margin_bottom = 1 text = "DI_cd_name" default_format = "#low" }
                                    hbox = {
                                        layoutpolicy_horizontal = expanding
                                        spacing = 12
                                        spacer = { size = { 100 35 } }
                                        text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 500 align = center text = "DI_cd_name_value" default_format = "#high" }
                                        button_standard = { size = { 100 35 } text = "DI_cd_edit" onclick = "[GetScriptedGui('DI_cd_edit_name_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                                    }
                                }
                                vbox = {
                                    name = "DI_cd_collective_row"
                                    layoutpolicy_horizontal = expanding
                                    margin = { 16 4 }
                                    spacing = 2
                                    background = { using = Background_Area }
                                    text_label_center = { layoutpolicy_horizontal = expanding margin_bottom = 1 text = "DI_cd_collective" default_format = "#low" }
                                    hbox = {
                                        layoutpolicy_horizontal = expanding
                                        spacing = 12
                                        spacer = { size = { 100 35 } }
                                        text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 500 align = center text = "DI_cd_collective_value" default_format = "#high" }
                                        button_standard = { size = { 100 35 } text = "DI_cd_edit" onclick = "[GetScriptedGui('DI_cd_edit_collective_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                                    }
                                }
                                vbox = {
                                    name = "DI_cd_prefix_row"
                                    layoutpolicy_horizontal = expanding
                                    margin = { 16 4 }
                                    spacing = 2
                                    background = { using = Background_Area }
                                    text_label_center = { layoutpolicy_horizontal = expanding margin_bottom = 1 text = "DI_cd_prefix" default_format = "#low" }
                                    hbox = {
                                        layoutpolicy_horizontal = expanding
                                        spacing = 12
                                        spacer = { size = { 100 35 } }
                                        text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 500 align = center text = "DI_cd_prefix_value" default_format = "#high" }
                                        button_standard = { size = { 100 35 } text = "DI_cd_edit" onclick = "[GetScriptedGui('DI_cd_edit_prefix_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                                    }
                                }
                                text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 780 align = center text = "DI_cd_name_help" default_format = "#low" }
                                vbox = {
                                    name = "DI_cd_draft_summary"
                                    layoutpolicy_horizontal = expanding
                                    margin = { 16 6 }
                                    spacing = 6
                                    background = { using = Background_Area_Dark }
                                    text_label_center = { layoutpolicy_horizontal = expanding margin_bottom = 1 text = "DI_cd_selected_pillars" default_format = "#high" }
                                    divider_light = { layoutpolicy_horizontal = expanding }
                                    hbox = {
                                        layoutpolicy_horizontal = expanding
                                        spacing = 24
                                        vbox = {
                                            layoutpolicy_horizontal = expanding
                                            spacing = 4
                                            text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 340 text = "DI_cd_summary_ethos" }
                                            text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 340 text = "DI_cd_summary_heritage" }
                                        }
                                        vbox = {
                                            layoutpolicy_horizontal = expanding
                                            spacing = 4
                                            text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 340 text = "DI_cd_summary_language" }
                                            text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 340 text = "DI_cd_summary_martial_custom" }
                                        }
                                    }
                                    text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 744 text = "DI_cd_inherit" default_format = "#low" }
                                }
                                vbox = {
                                    name = "DI_ch_parent_pillars_panel"
                                    layoutpolicy_horizontal = expanding
                                    visible = "[GetPlayer.MakeScope.Var('DI_cd_secondary').IsSet]"
                                    margin = { 16 6 }
                                    spacing = 6
                                    background = { using = Background_Area_Dark }
                                    text_label_center = { layoutpolicy_horizontal = expanding margin_bottom = 1 text = "DI_ch_parent_pillars" default_format = "#high" }
                                    text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 744 align = center text = "DI_ch_parent_pillars_hint" default_format = "#low" }
                                    divider_light = { layoutpolicy_horizontal = expanding }
                                    hbox = {
                                        layoutpolicy_horizontal = expanding
                                        spacing = 24
                                        vbox = {
                                            name = "DI_ch_source_pillar_choices"
                                            layoutpolicy_horizontal = expanding
                                            maximumsize = { 360 -1 }
                                            spacing = 4
                                            text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 340 align = center text = "DI_ch_source_pillars" default_format = "#high" }
                                            vbox = {
                                                layoutpolicy_horizontal = expanding
                                                spacing = 2
                                                text_label_center = { layoutpolicy_horizontal = expanding margin_bottom = 1 text = "DI_cd_ethos" default_format = "#low" }
                                                DI_cd_checked_button = {
                                                    name = "DI_ch_source_ethos"
                                                    layoutpolicy_horizontal = expanding
                                                    size = { 350 40 }
                                                    datacontext = "[GetPlayer.MakeScope.Var('DI_cd_source').Culture.GetEthos]"
                                                    text = "[CulturePillar.GetNameNoTooltip]"
                                                    tooltip = "DI_ch_parent_pillars_hint"
                                                    using = tooltip_es
                                                    down = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_ethos').CulturePillar)]"
                                                    onclick = "[GetScriptedGui('DI_cd_select_ethos_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pillar', CulturePillar.MakeScope).End)]"
                                                    blockoverride "DI_cd_selected_check" { visible = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_ethos').CulturePillar)]" }
                                                }
                                            }
                                            vbox = {
                                                layoutpolicy_horizontal = expanding
                                                spacing = 2
                                                text_label_center = { layoutpolicy_horizontal = expanding margin_bottom = 1 text = "DI_cd_heritage" default_format = "#low" }
                                                DI_cd_checked_button = {
                                                    name = "DI_ch_source_heritage"
                                                    layoutpolicy_horizontal = expanding
                                                    size = { 350 40 }
                                                    datacontext = "[GetPlayer.MakeScope.Var('DI_cd_source').Culture.GetHeritage]"
                                                    text = "[CulturePillar.GetNameNoTooltip]"
                                                    tooltip = "DI_ch_parent_pillars_hint"
                                                    using = tooltip_es
                                                    down = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_heritage').CulturePillar)]"
                                                    onclick = "[GetScriptedGui('DI_cd_select_heritage_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pillar', CulturePillar.MakeScope).End)]"
                                                    blockoverride "DI_cd_selected_check" { visible = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_heritage').CulturePillar)]" }
                                                }
                                            }
                                            vbox = {
                                                layoutpolicy_horizontal = expanding
                                                spacing = 2
                                                text_label_center = { layoutpolicy_horizontal = expanding margin_bottom = 1 text = "DI_cd_language" default_format = "#low" }
                                                DI_cd_checked_button = {
                                                    name = "DI_ch_source_language"
                                                    layoutpolicy_horizontal = expanding
                                                    size = { 350 40 }
                                                    datacontext = "[GetPlayer.MakeScope.Var('DI_cd_source').Culture.GetLanguage]"
                                                    text = "[CulturePillar.GetNameNoTooltip]"
                                                    tooltip = "DI_ch_parent_pillars_hint"
                                                    using = tooltip_es
                                                    down = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_language').CulturePillar)]"
                                                    onclick = "[GetScriptedGui('DI_cd_select_language_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pillar', CulturePillar.MakeScope).End)]"
                                                    blockoverride "DI_cd_selected_check" { visible = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_language').CulturePillar)]" }
                                                }
                                            }
                                            vbox = {
                                                layoutpolicy_horizontal = expanding
                                                spacing = 2
                                                text_label_center = { layoutpolicy_horizontal = expanding margin_bottom = 1 text = "DI_cd_martial_custom" default_format = "#low" }
                                                DI_cd_checked_button = {
                                                    name = "DI_ch_source_martial_custom"
                                                    layoutpolicy_horizontal = expanding
                                                    size = { 350 40 }
                                                    datacontext = "[GetPlayer.MakeScope.Var('DI_cd_source').Culture.GetMartial]"
                                                    text = "[CulturePillar.GetNameNoTooltip]"
                                                    tooltip = "DI_ch_parent_pillars_hint"
                                                    using = tooltip_es
                                                    down = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_martial_custom').CulturePillar)]"
                                                    onclick = "[GetScriptedGui('DI_cd_select_martial_custom_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pillar', CulturePillar.MakeScope).End)]"
                                                    blockoverride "DI_cd_selected_check" { visible = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_martial_custom').CulturePillar)]" }
                                                }
                                            }
                                        }
                                        vbox = {
                                            name = "DI_ch_secondary_pillar_choices"
                                            layoutpolicy_horizontal = expanding
                                            maximumsize = { 360 -1 }
                                            spacing = 4
                                            text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 340 align = center text = "DI_ch_secondary" default_format = "#high" }
                                            vbox = {
                                                layoutpolicy_horizontal = expanding
                                                spacing = 2
                                                text_label_center = { layoutpolicy_horizontal = expanding margin_bottom = 1 text = "DI_cd_ethos" default_format = "#low" }
                                                DI_cd_checked_button = {
                                                    name = "DI_ch_secondary_ethos"
                                                    layoutpolicy_horizontal = expanding
                                                    size = { 350 40 }
                                                    datacontext = "[GetPlayer.MakeScope.Var('DI_cd_secondary').Culture.GetEthos]"
                                                    text = "[CulturePillar.GetNameNoTooltip]"
                                                    tooltip = "DI_ch_parent_pillars_hint"
                                                    using = tooltip_es
                                                    down = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_ethos').CulturePillar)]"
                                                    onclick = "[GetScriptedGui('DI_cd_select_ethos_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pillar', CulturePillar.MakeScope).End)]"
                                                    blockoverride "DI_cd_selected_check" { visible = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_ethos').CulturePillar)]" }
                                                }
                                            }
                                            vbox = {
                                                layoutpolicy_horizontal = expanding
                                                spacing = 2
                                                text_label_center = { layoutpolicy_horizontal = expanding margin_bottom = 1 text = "DI_cd_heritage" default_format = "#low" }
                                                DI_cd_checked_button = {
                                                    name = "DI_ch_secondary_heritage"
                                                    layoutpolicy_horizontal = expanding
                                                    size = { 350 40 }
                                                    datacontext = "[GetPlayer.MakeScope.Var('DI_cd_secondary').Culture.GetHeritage]"
                                                    text = "[CulturePillar.GetNameNoTooltip]"
                                                    tooltip = "DI_ch_parent_pillars_hint"
                                                    using = tooltip_es
                                                    down = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_heritage').CulturePillar)]"
                                                    onclick = "[GetScriptedGui('DI_cd_select_heritage_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pillar', CulturePillar.MakeScope).End)]"
                                                    blockoverride "DI_cd_selected_check" { visible = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_heritage').CulturePillar)]" }
                                                }
                                            }
                                            vbox = {
                                                layoutpolicy_horizontal = expanding
                                                spacing = 2
                                                text_label_center = { layoutpolicy_horizontal = expanding margin_bottom = 1 text = "DI_cd_language" default_format = "#low" }
                                                DI_cd_checked_button = {
                                                    name = "DI_ch_secondary_language"
                                                    layoutpolicy_horizontal = expanding
                                                    size = { 350 40 }
                                                    datacontext = "[GetPlayer.MakeScope.Var('DI_cd_secondary').Culture.GetLanguage]"
                                                    text = "[CulturePillar.GetNameNoTooltip]"
                                                    tooltip = "DI_ch_parent_pillars_hint"
                                                    using = tooltip_es
                                                    down = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_language').CulturePillar)]"
                                                    onclick = "[GetScriptedGui('DI_cd_select_language_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pillar', CulturePillar.MakeScope).End)]"
                                                    blockoverride "DI_cd_selected_check" { visible = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_language').CulturePillar)]" }
                                                }
                                            }
                                            vbox = {
                                                layoutpolicy_horizontal = expanding
                                                spacing = 2
                                                text_label_center = { layoutpolicy_horizontal = expanding margin_bottom = 1 text = "DI_cd_martial_custom" default_format = "#low" }
                                                DI_cd_checked_button = {
                                                    name = "DI_ch_secondary_martial_custom"
                                                    layoutpolicy_horizontal = expanding
                                                    size = { 350 40 }
                                                    datacontext = "[GetPlayer.MakeScope.Var('DI_cd_secondary').Culture.GetMartial]"
                                                    text = "[CulturePillar.GetNameNoTooltip]"
                                                    tooltip = "DI_ch_parent_pillars_hint"
                                                    using = tooltip_es
                                                    down = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_martial_custom').CulturePillar)]"
                                                    onclick = "[GetScriptedGui('DI_cd_select_martial_custom_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pillar', CulturePillar.MakeScope).End)]"
                                                    blockoverride "DI_cd_selected_check" { visible = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_martial_custom').CulturePillar)]" }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            vbox = {
                                layoutpolicy_horizontal = expanding
                                margin_right = 24
                                visible = "[GetVariableSystem.HasValue('DI_cd_tab', 'pillars')]"
                                vbox = { layoutpolicy_horizontal = expanding
                                    visible = "[GetVariableSystem.HasValue('DI_cd_pillar_tab', 'ethos')]"
                                    text_single = { text = "DI_cd_summary_ethos" default_format = "#high" }
                                    fixedgridbox = {
                                        datamodel = "[GetGlobalList('DI_cd_pillars_ethos')]"
                                        flipdirection = yes addcolumn = 284 addrow = 56 datamodel_wrap = 3
                                        item = { DI_cd_checked_button = { size = { 276 48 }
                                            datacontext = "[Scope.CulturePillar]"
                                            text = "[CulturePillar.GetNameNoTooltip]"
                                            down = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_ethos').CulturePillar)]"
                                            onclick = "[GetScriptedGui('DI_cd_select_ethos_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pillar', CulturePillar.MakeScope).End)]"
                                            blockoverride "DI_cd_selected_check" { visible = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_ethos').CulturePillar)]" }
                                        } }
                                    }
                                }
                                vbox = { layoutpolicy_horizontal = expanding
                                    visible = "[GetVariableSystem.HasValue('DI_cd_pillar_tab', 'heritage')]"
                                    text_single = { text = "DI_cd_summary_heritage" default_format = "#high" }
                                    fixedgridbox = {
                                        datamodel = "[GetGlobalList('DI_cd_pillars_heritage')]"
                                        flipdirection = yes addcolumn = 284 addrow = 56 datamodel_wrap = 3
                                        item = { DI_cd_checked_button = { size = { 276 48 }
                                            datacontext = "[Scope.CulturePillar]"
                                            text = "[CulturePillar.GetNameNoTooltip]"
                                            down = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_heritage').CulturePillar)]"
                                            onclick = "[GetScriptedGui('DI_cd_select_heritage_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pillar', CulturePillar.MakeScope).End)]"
                                            blockoverride "DI_cd_selected_check" { visible = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_heritage').CulturePillar)]" }
                                        } }
                                    }
                                }
                                vbox = { layoutpolicy_horizontal = expanding
                                    visible = "[GetVariableSystem.HasValue('DI_cd_pillar_tab', 'language')]"
                                    text_single = { text = "DI_cd_summary_language" default_format = "#high" }
                                    fixedgridbox = {
                                        datamodel = "[GetGlobalList('DI_cd_pillars_language')]"
                                        flipdirection = yes addcolumn = 284 addrow = 56 datamodel_wrap = 3
                                        item = { DI_cd_checked_button = { size = { 276 48 }
                                            datacontext = "[Scope.CulturePillar]"
                                            text = "[CulturePillar.GetNameNoTooltip]"
                                            down = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_language').CulturePillar)]"
                                            onclick = "[GetScriptedGui('DI_cd_select_language_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pillar', CulturePillar.MakeScope).End)]"
                                            blockoverride "DI_cd_selected_check" { visible = "[ObjectsEqual(CulturePillar.Self, GetPlayer.MakeScope.Var('DI_cd_language').CulturePillar)]" }
                                        } }
