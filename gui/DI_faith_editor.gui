# Independent faith editor. Never bind this window to FaithWindow.
window = {
    name = "DI_faith_editor_window"
    layer = windows_layer
    position = { 680 80 }
    size = { 760 88% }
    movable = yes
    using = Window_Background
    using = Window_Decoration
    using = DI_Faith_Editor_Anim
    visible = "[GetVariableSystem.Exists('DI_faith_editor_window_visible')]"
    datacontext = "[GetPlayer.MakeScope.Var('DI_primary_character').Char]"
    datacontext = "[Character.GetFaith]"
    datacontext = "[GetPlayer.MakeScope.Var('DI_fe_rite').Rite]"

    vbox = {
        layoutpolicy_horizontal = expanding
        layoutpolicy_vertical = expanding
        using = Window_Margins
        ignoreinvisible = yes
        header_pattern = {
            layoutpolicy_horizontal = expanding
            blockoverride "header_text" { text = "DI_FAITH_EDITOR_TITLE" }
            blockoverride "button_close" {
                onclick = "[GetScriptedGui('DI_fe_cancel_tenet_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onclick = "[GetVariableSystem.Clear('DI_faith_editor_window_visible')]"
            }
        }
        widget = {
            size = { 600 200 }
            using = DI_Select_Primary_Character
            using = DI_Select_Secondary_Character
        }
        hbox = {
            layoutpolicy_horizontal = expanding
            visible = "[Character.IsValid]"
            spacing = 12

            # Icon+vbox are kept content-sized and flanked by expand spacers so the pair floats as one centered unit
            expand = {}
            icon = {
                size = { 65 65 }
                texture = "[Faith.GetIcon]"
                tooltipwidget = { faith_tooltip = {} }
            }
            vbox = {
                text_label_center = { text = "FAITH_VIEW_HEADING" }
                text_single = { text = "FAITH_VIEW_SUBHEADING" align = center }
                hbox = {
                    layoutpolicy_horizontal = expanding
                    expand = {}
                    fervor_container_hbox = {}
                    expand = {}
                }
            }
            # Mirrors the icon's footprint so the vbox (not just the group) centers on the window
            spacer = { size = { 65 0 } }
            expand = {}
        }
        hbox = {
            layoutpolicy_horizontal = expanding
            button_tab = {
                layoutpolicy_horizontal = expanding
                text = "DI_fe_character_rite"
                down = "[And(Not(GetVariableSystem.HasValue('DI_fe_tab', 'conversion')), Not(GetPlayer.MakeScope.Var('DI_fe_main_rite_mode').IsSet))]"
                onclick = "[GetScriptedGui('DI_fe_use_character_rite_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onclick = "[GetScriptedGui('DI_fe_sync_target_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onclick = "[GetVariableSystem.Clear('DI_fe_tab')]"
            }
            button_tab = {
                layoutpolicy_horizontal = expanding
                text = "DI_fe_main_rite"
                down = "[And(Not(GetVariableSystem.HasValue('DI_fe_tab', 'conversion')), GetPlayer.MakeScope.Var('DI_fe_main_rite_mode').IsSet)]"
                onclick = "[GetScriptedGui('DI_fe_use_main_rite_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onclick = "[GetScriptedGui('DI_fe_sync_target_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onclick = "[GetVariableSystem.Clear('DI_fe_tab')]"
            }
            button_tab = {
                layoutpolicy_horizontal = expanding
                text = "DI_fe_conversion_tab"
                down = "[GetVariableSystem.HasValue('DI_fe_tab', 'conversion')]"
                onclick = "[GetScriptedGui('DI_fe_cancel_tenet_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onclick = "[GetScriptedGui('DI_religion_list_load').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onclick = "[GetScriptedGui('DI_fe_conversion_init_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onclick = "[GetVariableSystem.Set('DI_fe_tab', 'conversion')]"
            }
        }
        vbox = {
            layoutpolicy_horizontal = expanding
            layoutpolicy_vertical = expanding
            spacing = 6
            visible = "[Not(GetVariableSystem.HasValue('DI_fe_tab', 'conversion'))]"
            text_single = {
                layoutpolicy_horizontal = expanding
                align = center
                text = "DI_fe_editing_rite"
                visible = "[Rite.IsValid]"
                tooltip = "DI_fe_target_help"
            }
            scrollbox = {
                layoutpolicy_horizontal = expanding
                layoutpolicy_vertical = expanding
                blockoverride "scrollbox_content" {
                    vbox = {
                        layoutpolicy_horizontal = expanding
                        visible = "[GetScriptedGui('DI_fe_target_current_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        spacing = 8
                        margin = { 8 8 }
                        hbox = {
                            layoutpolicy_horizontal = expanding
                            text_label_center = {
                                layoutpolicy_horizontal = expanding
                                text = "FAITH_CORE_TENETS_HEADING"
                            }
                            button_standard = {
                                text = "DI_add_tenet"
                                tooltip = "DI_fe_add_tenet_tooltip"
                                using = tooltip_ne
                                enabled = "[GetScriptedGui('DI_fe_open_add_tenet_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_rite', Rite.MakeScope).End)]"
                                onclick = "[GetScriptedGui('DI_fe_open_add_tenet_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_rite', Rite.MakeScope).End)]"
                            }
                        }
                        flowcontainer = {
                            layoutpolicy_horizontal = expanding
                            wrap_count = 3
                            spacing = 8
                            datamodel = "[Rite.GetTenets]"
                            item = {
                                DI_fe_tenet_card = {
                                    button_ignore = none
                                    onrightclick = "[GetScriptedGui('DI_fe_remove_tenet_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_rite', Rite.MakeScope).AddScope('tenet', TenetType.MakeScope).End)]"
                                    tooltip = "DI_fe_tenet_core_tooltip"
                                    blockoverride "DI_fe_tenet_action" {
                                        onclick = "[GetScriptedGui('DI_fe_select_tenet_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_rite', Rite.MakeScope).AddScope('tenet', TenetType.MakeScope).End)]"
                                    }
                                }
                            }
                        }
                        vbox = {
                            layoutpolicy_horizontal = expanding
                            spacing = 8
                            margin = { 8 8 }

                            using = DI_fe_generated_catalogue
                        }
                    }
                    vbox = {
                        layoutpolicy_horizontal = expanding
                        layoutpolicy_vertical = expanding
                        visible = "[Not(GetScriptedGui('DI_fe_target_current_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
                        expand = {}
                        text_multi = {
                            layoutpolicy_horizontal = expanding
                            align = center|vcenter|nobaseline
                            text = "DI_fe_invalid_target"
                        }
                        expand = {}
                    }
                }
            }
        }
        DI_fe_conversion_panel = {}
    }
}

window = {
    name = "DI_select_tenet_window"
    parentanchor = center
    layer = windows_layer
    size = { 800 75% }
    movable = yes
    using = Window_Background
    using = Window_Decoration
    visible = "[And(GetVariableSystem.Exists('DI_faith_editor_window_visible'), Or(GetPlayer.MakeScope.Var('DI_fe_old_tenet').TenetType.IsValid, GetPlayer.MakeScope.Var('DI_fe_add_tenet_mode').IsSet))]"
    datacontext = "[GetPlayer.MakeScope.Var('DI_fe_rite').Rite]"
    datacontext = "[Rite.GetFaith]"
    state = {
        name = _show
        using = Animation_FadeIn_Quick
        on_finish = "[PdxGuiWidget.StackTop]"
    }
    vbox = {
        using = Window_Margins
        layoutpolicy_horizontal = expanding
        layoutpolicy_vertical = expanding
        spacing = 10
        header_pattern = {
            layoutpolicy_horizontal = expanding
            blockoverride "header_text" {
                text = "[SelectLocalization(GetPlayer.MakeScope.Var('DI_fe_add_tenet_mode').IsSet, 'DI_add_tenet', 'DI_fe_replace_tenet_title')]"
            }
            blockoverride "button_close" { onclick = "[GetScriptedGui('DI_fe_cancel_tenet_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        }
        text_multi = {
            layoutpolicy_horizontal = expanding
            visible = "[GetPlayer.MakeScope.Var('DI_fe_add_tenet_mode').IsSet]"
            text = "DI_select_tenet"
        }
        text_multi = {
            layoutpolicy_horizontal = expanding
            visible = "[Not(GetPlayer.MakeScope.Var('DI_fe_add_tenet_mode').IsSet)]"
            text = "DI_fe_replacing_tenet"
        }
        scrollbox = {
            layoutpolicy_horizontal = expanding
            layoutpolicy_vertical = expanding
            blockoverride "scrollbox_content" {
                flowcontainer = {
                    layoutpolicy_horizontal = expanding
                    wrap_count = 4
                    spacing = 12
                    margin = { 8 8 }
                    ignoreinvisible = yes
                    datamodel = "[GetAllTenetTypes]"
                    item = {
                        DI_fe_tenet_picker_card = {
                            visible = "[And(TenetType.IsVisible, Not(GetScriptedGui('DI_fe_tenet_dlc_required_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tenet', TenetType.MakeScope).End)))]"
                            enabled = "[GetScriptedGui('DI_fe_replace_tenet_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_rite', Rite.MakeScope).AddScope('tenet', TenetType.MakeScope).End)]"
                            blockoverride "DI_fe_tenet_action" {
                                onclick = "[GetScriptedGui('DI_fe_replace_tenet_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_rite', Rite.MakeScope).AddScope('tenet', TenetType.MakeScope).End)]"
                            }
                        }
                    }
                }
                flowcontainer = {
                    layoutpolicy_horizontal = expanding
                    wrap_count = 4
                    spacing = 12
                    margin = { 8 8 }
                    ignoreinvisible = yes
                    datamodel = "[GetAllTenetTypes]"
                    item = {
                        DI_fe_tenet_picker_card = {
                            visible = "[GetScriptedGui('DI_fe_tenet_dlc_required_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tenet', TenetType.MakeScope).End)]"
                            enabled = "[GetScriptedGui('DI_fe_replace_tenet_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_rite', Rite.MakeScope).AddScope('tenet', TenetType.MakeScope).End)]"
                            blockoverride "DI_fe_tenet_action" {
                                onclick = "[GetScriptedGui('DI_fe_replace_tenet_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_rite', Rite.MakeScope).AddScope('tenet', TenetType.MakeScope).End)]"
                            }
                        }
                    }
                }
            }
        }
    }
}

# Inert compatibility anchor for hot reloads of the old editor. No catalogue loading.
widget = {
    name = "DI_faith_editor_loader"
    size = { 0 0 }
    visible = no
    alwaystransparent = yes
}
