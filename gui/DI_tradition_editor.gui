### Tradition Editor Window ###

window = {
	name = "DI_tradition_editor_window"
	parentanchor = center
	size = { 820 950 }
	layer = windows_layer

	using = Window_Background
	using = Window_Decoration
	
	datacontext = "[GetVariableSystem]"
	datacontext = "[GetPlayer]"
	datacontext = "[GetPlayer.MakeScope.Var('DI_innovation_selected_culture').Culture]"

	state = {
		name = _show
		using = Animation_FadeIn_Quick

		on_start = "[GetScriptedGui('DI_tradition_picker_init_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		on_start = "[GetVariableSystem.Set('DI_tradition_editor_window_tab', 'realm')]"
		on_finish = "[PdxGuiWidget.StackTop]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		on_start = "[GetScriptedGui('DI_tradition_clear_replacement_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}

	visible = "[GetVariableSystem.Exists('DI_tradition_editor_window_visible')]"
	
	vbox = {
		using = Window_Margins
		minimumsize = { 820 0 }

		header_pattern = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text"
			{
				text = "[SelectLocalization(GetPlayer.MakeScope.Var('DI_tradition_to_replace').IsSet, 'REPLACE_TRADITION_WINDOW_TITLE', 'ADD_TRADITION_WINDOW_TITLE')]"
			}

			blockoverride "button_close"
			{
				onclick = "[GetScriptedGui('DI_tradition_clear_replacement_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			onclick = "[GetVariableSystem.Toggle('DI_tradition_editor_window_visible')]"
			}
		}

		text_multi = {
			layoutpolicy_horizontal = expanding
			align = center
			visible = "[GetPlayer.MakeScope.Var('DI_tradition_to_replace').IsSet]"
			text = "DI_tradition_replacing_status"
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 4 0 }
			button_tab = {
				layoutpolicy_horizontal = expanding
				onclick = "[GetVariableSystem.Set('DI_tradition_editor_window_tab', 'realm')]"
				down = "[GetVariableSystem.HasValue('DI_tradition_editor_window_tab', 'realm')]"
				vbox = {
					layoutpolicy_horizontal = expanding
					text_single = {
						layoutpolicy_horizontal = expanding
						align = center
						text = "tradition_group_realm"
					}
					text_single = {
						align = center
						text = "[GetDataModelSize(GetGlobalList('DI_tradition_picker_realm'))]"
					}
				}
			}
			button_tab = {
				layoutpolicy_horizontal = expanding
				onclick = "[GetVariableSystem.Set('DI_tradition_editor_window_tab', 'combat')]"
				down = "[GetVariableSystem.HasValue('DI_tradition_editor_window_tab', 'combat')]"
				vbox = {
					layoutpolicy_horizontal = expanding
					text_single = {
						layoutpolicy_horizontal = expanding
						align = center
						text = "tradition_group_combat"
					}
					text_single = {
						align = center
						text = "[GetDataModelSize(GetGlobalList('DI_tradition_picker_combat'))]"
					}
				}
			}
			button_tab = {
				layoutpolicy_horizontal = expanding
				onclick = "[GetVariableSystem.Set('DI_tradition_editor_window_tab', 'societal')]"
				down = "[GetVariableSystem.HasValue('DI_tradition_editor_window_tab', 'societal')]"
				vbox = {
					layoutpolicy_horizontal = expanding
					text_single = {
						layoutpolicy_horizontal = expanding
						align = center
						text = "tradition_group_societal"
					}
					text_single = {
						align = center
						text = "[GetDataModelSize(GetGlobalList('DI_tradition_picker_societal'))]"
					}
				}
			}
			button_tab = {
				layoutpolicy_horizontal = expanding
				onclick = "[GetVariableSystem.Set('DI_tradition_editor_window_tab', 'ritual')]"
				down = "[GetVariableSystem.HasValue('DI_tradition_editor_window_tab', 'ritual')]"
				vbox = {
					layoutpolicy_horizontal = expanding
					text_single = {
						layoutpolicy_horizontal = expanding
						align = center
						text = "tradition_group_ritual"
					}
					text_single = {
						align = center
						text = "[GetDataModelSize(GetGlobalList('DI_tradition_picker_ritual'))]"
					}
				}
			}
			button_tab = {
				layoutpolicy_horizontal = expanding
				onclick = "[GetVariableSystem.Set('DI_tradition_editor_window_tab', 'regional')]"
				down = "[GetVariableSystem.HasValue('DI_tradition_editor_window_tab', 'regional')]"
				vbox = {
					layoutpolicy_horizontal = expanding
					text_single = {
						layoutpolicy_horizontal = expanding
						align = center
						text = "tradition_group_regional"
					}
					text_single = {
						align = center
						text = "[GetDataModelSize(GetGlobalList('DI_tradition_picker_regional'))]"
					}
				}
			}
			button_tab = {
				layoutpolicy_horizontal = expanding
				onclick = "[GetVariableSystem.Set('DI_tradition_editor_window_tab', 'other')]"
				down = "[GetVariableSystem.HasValue('DI_tradition_editor_window_tab', 'other')]"
				vbox = {
					layoutpolicy_horizontal = expanding
					text_single = {
						layoutpolicy_horizontal = expanding
						align = center
						text = "DI_tradition_picker_other"
					}
					text_single = {
						align = center
						text = "[GetDataModelSize(GetGlobalList('DI_tradition_picker_other'))]"
					}
				}
			}
		}

		vbox = {
			name = "DI_tradition_selection"
			ignoreinvisible = yes
			margin = { 0 8 }
			spacing = 6

			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			widget = {
				name = "DI_traditions_scroll_area"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				scrollbox = {
					name = "DI_traditions_category_scrollbox"
					size = { 100% 100% }
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					blockoverride "scrollbox_content"
					{
						fixedgridbox = {
							datamodel = "[GetGlobalList(ConcatIfNeitherEmpty('DI_tradition_picker_', GetVariableSystem.Get('DI_tradition_editor_window_tab')))]"
							flipdirection = yes
							addcolumn = 240
							addrow = 192
							datamodel_wrap = 3

							item = {
								DI_widget_tradition_item = {
									datacontext = "[Scope.CultureTradition]"
								}
							}
						}
					}
				}

				# Center in the viewport, even when the scroll content has no rows.
				text_multi = {
					name = "DI_tradition_other_empty_message"
					parentanchor = center
					widgetanchor = center
					size = { 90% 80 }
					autoresize = no
					align = center|nobaseline
					visible = "[And(GetVariableSystem.HasValue('DI_tradition_editor_window_tab', 'other'), EqualTo_int32(GetDataModelSize(GetGlobalList('DI_tradition_picker_other')), '(int32)0'))]"
					text = "DI_tradition_picker_other_empty"
					default_format = "#high"
					alwaystransparent = yes
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 44 8 }
				spacing = 20

				button_standard = {
					name = "clear_traditions"
					text = DI_CLEAR_ALL_TRADITIONS

					onclick = "[GetScriptedGui('DI_clear_all_traditions').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				# button_standard = {
				# 	name = "DI_all_traditions"
				# 	text = DI_all_traditions

				# 	onclick = "[GetScriptedGui('DI_set_tradition').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tradition', GetCultureTradition('tradition_winter_warriors').MakeScope).End)]"
				# }
			}
		}
	}
}

types DI_CultureAddTraditionTypes
{
	type DI_widget_tradition_item = widget {
		size = { 240 192 }

		# Match the faith editor tenet cards, using live membership in the edited culture.
		background = {
			visible = "[GetScriptedGui('DI_tradition_is_current_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tradition', CultureTradition.MakeScope).End)]"
			using = Status_Good
			using = Color_Blue
			alpha = 0.45
		}

		tooltip = "DI_tradition_picker_tooltip"
		using = tooltip_es

		vbox = {
			visible = "[CultureTradition.IsValid]"
			button_standard = {
				size = {  220 120  }
				enabled = "[Or(GetScriptedGui('DI_tradition_is_current_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tradition', CultureTradition.MakeScope).End), GetScriptedGui('DI_tradition_dlc_available_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tradition', CultureTradition.MakeScope).End))]"
				tooltip = "DI_tradition_picker_tooltip"
				using = tooltip_es
				onclick = "[GetScriptedGui('DI_set_tradition').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tradition', CultureTradition.MakeScope).End)]"
				onrightclick = "[GetScriptedGui('DI_tradition_picker_remove_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tradition', CultureTradition.MakeScope).End)]"
				button_ignore = none

				widget_tradition_icon = {
					alwaystransparent = yes
					block "icon_size" {
						size = { 220 120 }
					}
				}

				widget = {
					name = "DI_tradition_current_gold_glow"
					visible = "[GetScriptedGui('DI_tradition_is_current_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tradition', CultureTradition.MakeScope).End)]"
					parentanchor = center
					size = { 100% 100% }
					alwaystransparent = yes
					alpha = 0.85
					background = {
						texture = "gfx/interface/component_effects/innovation_glow.dds"
						margin = { 14 12 }
						spriteType = Corneredstretched
						spriteborder = { 30 30 }
						tintcolor = { 1 0.78 0.25 1 }
					}
				}

				icon = {
					name = "DI_tradition_current_check"
					visible = "[GetScriptedGui('DI_tradition_is_current_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tradition', CultureTradition.MakeScope).End)]"
					parentanchor = top|right
					position = { -6 6 }
					size = { 32 32 }
					texture = "gfx/interface/icons/symbols/icon_check.dds"
					alwaystransparent = yes
				}

			}

			hbox = {
				margin_top = 4

				text_label_center = {
					name = "name"
					text = "[CultureTradition.GetNameNoTooltip]"
					tooltip = "DI_tradition_picker_tooltip"
					using = tooltip_es
					maximumsize = { 180 44 }
					multiline = yes
					align = center|nobaseline

					using = Font_Size_Medium
				}
			}

			text_single = {
				size = { 220 20 }
				align = center|nobaseline
				visible = "[GetScriptedGui('DI_tradition_is_current_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tradition', CultureTradition.MakeScope).End)]"
				text = "DI_fe_current"
				default_format = "#high;bold"
				background = {
					using = Status_Good
					using = Color_Blue
					alpha = 0.9
				}
				alwaystransparent = yes
			}
		}
	}
}