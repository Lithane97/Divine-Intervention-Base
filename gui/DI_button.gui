                    state = {
                        name = _mouse_enter
                        scale = 1.15
                        position_x = -7
                        position_y = -3.5
                        duration = 0.1
                        using = Animation_Curve_Default
                    }
                    state = {
                        name = _mouse_leave
                        scale = 1
                        position_x = 0
                        position_y = 0
                        duration = 0.1
                        using = Animation_Curve_Default
                    }
                }
            }
        }
