                button_normal = {
                    name = "DI_shortcut_button"
                    size = { 45 45 }
                    texture = "gfx/interface/icons/DI_sidebar_divine_hand/DI_sidebar_divine_hand_v2.dds"
                    onclick = "[GetVariableSystem.Toggle('DI_main_visible')]"
                    down = "[GetVariableSystem.Exists('DI_main_visible')]"
