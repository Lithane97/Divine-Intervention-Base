widget = {
    name = DI_button
    visible = "[And( And(Not( IsPauseMenuShown ), Not(IsObserver)), And(Not(IsRightWindowOpen), And(IsDefaultGUIMode, And(Not(IsGameViewOpen('barbershop')), Not(IsGameViewOpen('royal_court')) ) ) ) )]"
    parentanchor = bottom|right
    size = { 70 40 }
    position = { -10 -300 }

    layer = hud_layer
    using = Animation_ShowHide_Quick

    state = {
        name = "story_check"
        trigger_when = "[GetScriptedGui('DI_misc_variable_story_check').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        on_start = "[GetScriptedGui('DI_misc_variable_story_check').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }

    flowcontainer = {
        ignoreinvisible = no
        visible = "[GetScriptedGui('DI_hide_button_check').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End )]" # This has to go here to prevent error log spam from observer mode

        button_round = {
            name = "DI_shortcut_button_advcm"
            size = { 40 40 }

            blockoverride "button_bg_color" {
                color = { 0.12 0.08 0.04 1 }
            }

            glow = {
                color = { 0.86 0.61 0.24 1 }
                glow_radius = 4
                using = Glow_Standard
                alpha = 0
            }

            visible = "[GetScriptedGui('DI_advcm_check').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

            onclick = "[GetVariableSystem.Toggle('DI_main_visible')]"
            tooltip = DI_button_tt

            state = {
                name = _mouse_enter
                glow_alpha = 0.22
                duration = 0.18
                using = Animation_Curve_Default
            }

            state = {
                name = _mouse_leave
                glow_alpha = 0
                duration = 0.2
                using = Animation_Curve_Default
            }

            button_prison_execute = {
                parentanchor = center
                alwaystransparent = yes
                size = { 25 25 }
            }
        }

        button_round = {
            name = "DI_shortcut_button"
            size = { 40 40 }

            blockoverride "button_bg_color" {
                color = { 0.12 0.08 0.04 1 }
            }

            glow = {
                color = { 0.86 0.61 0.24 1 }
                glow_radius = 4
                using = Glow_Standard
                alpha = 0
            }

            visible = "[Not(GetScriptedGui('DI_advcm_check').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"

            onclick = "[GetVariableSystem.Toggle('DI_main_visible')]"
            tooltip = DI_button_tt

            state = {
                name = _mouse_enter
                glow_alpha = 0.22
                duration = 0.18
                using = Animation_Curve_Default
            }

            state = {
                name = _mouse_leave
                glow_alpha = 0
                duration = 0.2
                using = Animation_Curve_Default
            }

            button_prison_execute = {
                parentanchor = center
                alwaystransparent = yes
                size = { 25 25 }
            }
        }
    }
}
